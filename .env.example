# Copia este archivo a apps/api/.env (o .env en la raíz) y rellena los valores.
# NUNCA commitees el .env real.

# Postgres en Neon. Usa sslmode=require y, preferible, la URL "pooled".
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require"

# Puerto local del API (Render inyecta PORT automáticamente en producción).
PORT=3000

# --- Auth0 (Identity, Día 2) ---
# El dominio del tenant (sin https://). Ej: dev-xxxx.us.auth0.com
AUTH0_DOMAIN="dev-xxxx.us.auth0.com"
# El identifier/audience de la API creada en Auth0 (NO una URL de app).
AUTH0_AUDIENCE="https://api.automecanica.do"
# El issuer del tenant, CON https y barra final. Ej: https://dev-xxxx.us.auth0.com/
AUTH0_ISSUER_URL="https://dev-xxxx.us.auth0.com/"

# --- Pagos: CardNet (Payments + Ledger, Día 3) ---
# Adapter en sandbox/mock por ahora; el comprador enchufa credenciales reales.
# Secreto para verificar la firma HMAC de los webhooks. OBLIGATORIO en producción
# (la app falla al arrancar si falta y NODE_ENV=production). Pon uno propio.
CARDNET_WEBHOOK_SECRET="replace-with-your-cardnet-webhook-secret"
# Base de la API de CardNet (sandbox). El adapter real apuntará aquí.
CARDNET_API_BASE="https://sandbox.cardnet.com.do"

# --- Tests de integración (opcional) ---
# Si se setea, los tests de integración usan esta DB (CI). Si no, se levanta un
# Postgres efímero con embedded-postgres (local). NUNCA apuntes esto a Neon prod.
# TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mechmate_test"
