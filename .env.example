# Copia este archivo a apps/api/.env y rellena los valores.
# NUNCA commitees el .env real.

# --- Credenciales de la DB: van en apps/api/env.txt, NO aquí ---
# env.txt (gitignored) tiene solo:
#   PGUSER=neondb_owner
#   PGPASSWORD=...
# Las URLs de abajo las toman vía ${PGUSER}/${PGPASSWORD} (src/config/load-env.ts).
# Rotar la contraseña = editar solo env.txt. En Render no hay env.txt: ahí
# DATABASE_URL se carga completa en el dashboard.

# Postgres en Neon. Usa sslmode=require y, preferible, la URL "pooled".
DATABASE_URL="postgresql://${PGUSER}:${PGPASSWORD}@HOST-pooler.neon.tech/DBNAME?sslmode=require"
# Conexión directa (sin pooler), para migraciones.
DIRECT_URL="postgresql://${PGUSER}:${PGPASSWORD}@HOST.neon.tech/DBNAME?sslmode=require"

# Puerto local del API (Render inyecta PORT automáticamente en producción).
PORT=3000

# --- Redis (colas BullMQ: outbox → eventos de dominio, Día 3) ---
# Local: docker run -d --name mechmate-redis -p 6379:6379 redis:7-alpine
# Render: "Internal Key Value URL" del Key Value (redis://red-xxxx:6379).
# OBLIGATORIO en producción; en dev, sin él las colas quedan deshabilitadas.
REDIS_URL="redis://localhost:6379"

# Relay del outbox (corre dentro de la API). Opcionales.
# OUTBOX_RELAY_ENABLED=false  → no publica en esta instancia (p. ej. si se separa en un worker).
# OUTBOX_POLL_MS=5000         → cada cuánto revisa eventos pendientes (mínimo 500).

# --- Mensajería (Día 3) ---
# Sin RESEND_API_KEY el email es simulado (log + tabla messages). Con ella, envío
# real por Resend (resend.com, gratis 3.000/mes). Sin dominio verificado solo
# entrega desde onboarding@resend.dev y al email dueño de la cuenta.
# RESEND_API_KEY=re_xxxxxxxx      ← secreto: en local va en apps/api/env.txt
# EMAIL_FROM="MechMate <onboarding@resend.dev>"

# --- Archivos: Cloudflare R2 (fotos de la DVI, Día 6) ---
# Bucket PRIVADO; el teléfono sube/descarga directo con URLs firmadas que vencen.
# Obligatorio en producción. Secretos: en local van en apps/api/env.txt.
# Token: R2 → Manage API Tokens → "Object Read & Write" solo para el bucket.
# R2_ACCOUNT_ID=<32 hex, la parte de <id>.r2.cloudflarestorage.com>
# R2_ACCESS_KEY_ID=...
# R2_SECRET_ACCESS_KEY=...
# R2_BUCKET=mechmate-dvi

# --- Aprobación del cliente (Día 6) ---
# Base pública de los enlaces que recibe el cliente (p. ej. la URL de Render).
PUBLIC_BASE_URL="http://localhost:3000"
# Firma HMAC de los enlaces (el token no se guarda en ningún lado). Secreto,
# 32+ caracteres, obligatorio en producción: openssl rand -hex 32
# APPROVAL_LINK_SECRET=...   ← en local va en apps/api/env.txt

# --- Errores: Sentry (Día 3) ---
# Sin SENTRY_DSN no se reporta nada (local/tests). Solo 5xx y eventos en
# dead-letter; nunca cuerpos, cookies ni tokens. En local va en apps/api/env.txt.
# SENTRY_DSN=https://xxxx@oXXXX.ingest.us.sentry.io/XXXX
# SENTRY_ENVIRONMENT=staging   ← opcional; por defecto usa NODE_ENV

# --- Auth0 (Identity, Día 2) ---
# El dominio del tenant (sin https://). Ej: dev-xxxx.us.auth0.com
AUTH0_DOMAIN="dev-xxxx.us.auth0.com"
# El identifier/audience de la API creada en Auth0 (NO una URL de app).
AUTH0_AUDIENCE="https://api.automecanica.do"
# El issuer del tenant, CON https y barra final. Ej: https://dev-xxxx.us.auth0.com/
AUTH0_ISSUER_URL="https://dev-xxxx.us.auth0.com/"

# --- Pagos: CardNet (Payments + Ledger, Día 3) ---
# Adapter en sandbox/mock por ahora; el comprador enchufa credenciales reales.
# Secreto para verificar la firma HMAC de los webhooks. OBLIGATORIO en producción
# (la app falla al arrancar si falta y NODE_ENV=production). Pon uno propio.
CARDNET_WEBHOOK_SECRET="replace-with-your-cardnet-webhook-secret"
# Base de la API de CardNet (sandbox). El adapter real apuntará aquí.
CARDNET_API_BASE="https://sandbox.cardnet.com.do"

# --- Tests de integración (opcional) ---
# Si se setea, los tests de integración usan esta DB (CI). Si no, se levanta un
# Postgres efímero con embedded-postgres (local). NUNCA apuntes esto a Neon prod.
# TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mechmate_test"
