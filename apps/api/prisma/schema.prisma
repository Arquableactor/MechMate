// Prisma schema — Identity (Día 2) sobre la fundación del Día 1.
// Convenciones CLAUDE.md: snake_case en DB, PK uuid v7 (ordenable por tiempo),
// timestamps timestamptz, una cuenta con múltiples roles (no-negociable #5).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [citext]
}

/// Conjunto canónico de roles de dominio. Viven en la DB, no en Auth0.
enum Role {
  mechanic
  seller
  customer
  courier
  admin
}

/// Tipo de taller/negocio dueño de un `shop`.
enum ShopType {
  mechanic_shop
  parts_seller
}

// --- Payments + Ledger (Día 3) ---

/// Dueño contable de una `ledger_account`. `platform`/`tax` usan owner_id NULL.
enum LedgerOwnerType {
  platform
  seller
  buyer
  courier
  tax
}

/// Naturaleza de la cuenta contable.
enum LedgerAccountKind {
  escrow_pending
  available
  commission_revenue
  tax_payable
  clearing
}

enum PaymentProvider {
  cardnet
}

enum PaymentStatus {
  requires_action
  captured
  failed
  refunded
}

enum PayoutStatus {
  scheduled
  paid
  failed
}

/// Tabla trivial para validar conexión y migraciones contra Neon (Día 1).
model Healthcheck {
  id         String   @id @default(uuid(7)) @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(6)

  @@map("_healthcheck")
}

/// Cuenta local, vinculada a Auth0 por `auth0_sub`. Una cuenta = múltiples roles.
/// NOTA: `email` se materializa como `citext` en la migración (Prisma no tiene
/// tipo nativo citext). Por eso futuros `migrate dev` pueden marcar drift en
/// `email` — preservar el tipo citext al regenerar migraciones.
model Account {
  id         String   @id @default(uuid(7)) @db.Uuid
  auth0_sub  String   @unique
  email      String?  @unique
  /// Auth0 confirmó el email (claim email_verified). Requisito para vincular
  /// invitaciones a talleres: un email sin verificar no prueba identidad.
  email_verified Boolean @default(false)
  phone      String?  @unique
  full_name  String?
  status     String   @default("active")
  kyc_status String   @default("none")
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)

  roles       AccountRole[]
  shops       Shop[]
  memberships ShopMember[]

  @@map("accounts")
}

/// Roles asignados a una cuenta. PK compuesta ⇒ idempotencia natural por (cuenta, rol).
model AccountRole {
  account_id String @db.Uuid
  role       Role

  account Account @relation(fields: [account_id], references: [id], onDelete: Cascade)

  @@id([account_id, role])
  @@map("account_roles")
}

/// Taller / repuestero. Solo la tabla (el onboarding es Día 4).
model Shop {
  id             String   @id @default(uuid(7)) @db.Uuid
  owner_id       String   @db.Uuid
  type           ShopType
  name           String
  commission_bps Int      @default(800)
  created_at     DateTime @default(now()) @db.Timestamptz(6)
  updated_at     DateTime @updatedAt @db.Timestamptz(6)

  owner     Account      @relation(fields: [owner_id], references: [id])
  payouts   Payout[]
  members   ShopMember[]
  customers   Customer[]
  vehicles    Vehicle[]
  sequences   ShopSequence[]
  work_orders WorkOrder[]

  @@map("shops")
}

/// Cuenta contable. El UNIQUE(owner_type, owner_id, kind, currency) se crea en SQL
/// crudo con NULLS NOT DISTINCT (Prisma no lo modela) — por eso NO hay @@unique
/// aquí. Las cuentas singleton (platform/tax, owner_id NULL) se siembran en la
/// migración. Futuros `migrate dev` marcarán drift en ese índice: preservarlo.
model LedgerAccount {
  id         String            @id @default(uuid(7)) @db.Uuid
  owner_type LedgerOwnerType
  owner_id   String?           @db.Uuid
  kind       LedgerAccountKind
  currency   String            @default("DOP")
  created_at DateTime          @default(now()) @db.Timestamptz(6)
  updated_at DateTime          @updatedAt @db.Timestamptz(6)

  postings LedgerPosting[]

  @@map("ledger_accounts")
}

/// Asiento contable. Inmutable (append-only); correcciones por asiento de reversa.
/// Triggers de balance (DEFERRED) e inmutabilidad viven en SQL crudo.
model LedgerEntry {
  id           String   @id @default(uuid(7)) @db.Uuid
  external_ref String?
  description  String?
  created_at   DateTime @default(now()) @db.Timestamptz(6)

  postings LedgerPosting[]

  @@map("ledger_entries")
}

/// Línea de un asiento. `amount_cents` bigint (positivo=crédito, negativo=débito).
/// Inmutable. La suma por `entry_id` debe ser 0 (trigger DEFERRED).
model LedgerPosting {
  id           String   @id @default(uuid(7)) @db.Uuid
  entry_id     String   @db.Uuid
  account_id   String   @db.Uuid
  amount_cents BigInt
  currency     String
  created_at   DateTime @default(now()) @db.Timestamptz(6)

  entry   LedgerEntry   @relation(fields: [entry_id], references: [id])
  account LedgerAccount @relation(fields: [account_id], references: [id])

  @@index([account_id])
  @@index([entry_id])
  @@map("ledger_postings")
}

/// Pago delegado al PSP (CardNet). Idempotente por `idempotency_key`.
model Payment {
  id              String          @id @default(uuid(7)) @db.Uuid
  order_id        String?         @db.Uuid
  provider        PaymentProvider @default(cardnet)
  provider_ref    String?
  amount_cents    BigInt
  currency        String          @default("DOP")
  status          PaymentStatus   @default(requires_action)
  idempotency_key String          @unique
  created_at      DateTime        @default(now()) @db.Timestamptz(6)
  updated_at      DateTime        @updatedAt @db.Timestamptz(6)

  @@map("payments")
}

/// Pago programado a un taller (primitiva mínima; sin reglas de scheduling).
model Payout {
  id           String      @id @default(uuid(7)) @db.Uuid
  shop_id      String      @db.Uuid
  amount_cents BigInt
  currency     String      @default("DOP")
  status       PayoutStatus @default(scheduled)
  scheduled_for DateTime    @db.Date
  created_at   DateTime    @default(now()) @db.Timestamptz(6)
  updated_at   DateTime    @updatedAt @db.Timestamptz(6)

  shop Shop @relation(fields: [shop_id], references: [id])

  @@map("payouts")
}

/// Outbox transaccional: el evento se escribe en la MISMA tx que el cambio de
/// estado; el OutboxRelay lo encola en BullMQ y setea `published_at`. NO es
/// inmutable. `updated_at` lleva default en DB (no solo @updatedAt) para que la
/// versión anterior de la API pueda seguir insertando durante un deploy.
model OutboxEvent {
  id           String    @id @default(uuid(7)) @db.Uuid
  topic        String
  payload      Json      @db.JsonB
  published_at DateTime? @db.Timestamptz(6)
  created_at   DateTime  @default(now()) @db.Timestamptz(6)
  updated_at   DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  @@index([published_at])
  @@map("outbox")
}

// --- Messaging (Día 3) ---

enum MessageChannel {
  email
  push
  whatsapp
}

enum MessageStatus {
  queued
  sent
  failed
}

/// Registro de cada mensaje saliente (auditable). Lo escribe SOLO el módulo de
/// mensajería. `account_id` cruza a Identity por ID, sin FK (fronteras entre
/// módulos). `dedupe_key` hace idempotente el envío: un reintento del mismo
/// evento no vuelve a mandar lo que ya salió.
model Message {
  id           String         @id @default(uuid(7)) @db.Uuid
  account_id   String?        @db.Uuid
  channel      MessageChannel
  recipient    String
  template     String
  subject      String?
  body         String
  payload      Json           @default("{}") @db.JsonB
  status       MessageStatus  @default(queued)
  attempts     Int            @default(0)
  last_error   String?
  provider_ref String?
  dedupe_key   String         @unique
  sent_at      DateTime?      @db.Timestamptz(6)
  created_at   DateTime       @default(now()) @db.Timestamptz(6)
  updated_at   DateTime       @updatedAt @db.Timestamptz(6)

  @@index([account_id])
  @@index([status])
  @@map("messages")
}

// --- Shops: membresía y roles dentro del taller (Día 4) ---

enum ShopMemberRole {
  owner
  mechanic
  advisor
}

enum ShopMemberStatus {
  invited
  active
}

/// Quién trabaja en cada taller y con qué rol. Es la base del aislamiento
/// multi-tenant: solo un miembro `active` accede a `/v1/shops/:shopId/...`.
/// Una invitación pendiente tiene `invited_email` y aún no `account_id`
/// (CHECKs en la migración: email en minúsculas; `active` exige cuenta).
model ShopMember {
  id            String           @id @default(uuid(7)) @db.Uuid
  shop_id       String           @db.Uuid
  account_id    String?          @db.Uuid
  invited_email String?
  role          ShopMemberRole
  status        ShopMemberStatus @default(active)
  created_at    DateTime         @default(now()) @db.Timestamptz(6)
  updated_at    DateTime         @updatedAt @db.Timestamptz(6)

  shop    Shop     @relation(fields: [shop_id], references: [id])
  account Account? @relation(fields: [account_id], references: [id], onDelete: Restrict)

  @@unique([shop_id, account_id])
  @@unique([shop_id, invited_email])
  @@index([account_id])
  @@map("shop_members")
}

// --- VIN (Día 4) ---

/// Caché GLOBAL de VINs decodificados (datos públicos del fabricante, no del
/// taller: no es multi-tenant). Evita repetir llamadas al proveedor y la reusa
/// Fitment del marketplace (Día 9). Solo se guardan decodificaciones exitosas.
model VinDecode {
  id           String   @id @default(uuid(7)) @db.Uuid
  vin          String   @unique
  provider     String
  make         String
  model        String?
  year         Int?
  trim         String?
  engine       String?
  fuel_type    String?
  body_class   String?
  drive_type   String?
  transmission String?
  /// Avisos del proveedor tal cual (auditoría).
  provider_warnings String[] @default([])
  raw          Json     @db.JsonB
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  updated_at   DateTime @updatedAt @db.Timestamptz(6)

  @@map("vin_decodes")
}

// --- Clientes del taller (Día 4) ---

/// Cliente de UN taller (multi-tenant por `shop_id`): el mecánico lo registra
/// aunque nunca instale la app. `account_id` lo vincula a una cuenta si luego se
/// registra (cruce a Identity por ID, sin FK). Teléfono en E.164 y cédula en
/// 11 dígitos: un mismo cliente no se duplica dentro del taller.
model Customer {
  id          String   @id @default(uuid(7)) @db.Uuid
  shop_id     String   @db.Uuid
  full_name   String
  phone       String?
  email       String?
  document_id String?
  account_id  String?  @db.Uuid
  notes       String?
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @updatedAt @db.Timestamptz(6)

  shop        Shop        @relation(fields: [shop_id], references: [id])
  vehicles    Vehicle[]
  work_orders WorkOrder[]

  /// Destino de la FK compuesta de vehicles: un vehículo solo puede ser de un
  /// cliente del MISMO taller (lo garantiza la DB, no solo el código).
  @@unique([id, shop_id])
  @@unique([shop_id, phone])
  @@unique([shop_id, document_id])
  @@index([shop_id, created_at])
  @@map("customers")
}

// --- Vehículos del taller (Día 4) ---

enum VehicleDataSource {
  vin_decode
  manual
}

/// Vehículo de un cliente, por taller (multi-tenant). La FK compuesta
/// (customer_id, shop_id) impide EN LA DB asignarlo a un cliente de otro
/// taller. Se identifica por VIN, chasis (importados de Japón) o placa: al
/// menos uno (CHECK), sin repetirse dentro del taller.
model Vehicle {
  id             String            @id @default(uuid(7)) @db.Uuid
  shop_id        String            @db.Uuid
  customer_id    String            @db.Uuid
  vin            String?
  chassis_number String?
  plate          String?
  make           String
  model          String?
  year           Int?
  trim           String?
  engine         String?
  fuel_type      String?
  color          String?
  mileage_km     Int?
  data_source    VehicleDataSource
  notes          String?
  created_at     DateTime          @default(now()) @db.Timestamptz(6)
  updated_at     DateTime          @updatedAt @db.Timestamptz(6)

  shop        Shop        @relation(fields: [shop_id], references: [id])
  customer    Customer    @relation(fields: [customer_id, shop_id], references: [id, shop_id])
  work_orders WorkOrder[]

  /// Destino de la FK compuesta de work_orders (vehículo del MISMO taller).
  @@unique([id, shop_id])
  @@unique([shop_id, vin])
  @@unique([shop_id, chassis_number])
  @@unique([shop_id, plate])
  @@index([shop_id, customer_id])
  @@map("vehicles")
}

// --- Órdenes de trabajo (Día 5) ---

/// Contadores por taller (p. ej. número de OT). Se incrementan con un
/// INSERT … ON CONFLICT DO UPDATE … RETURNING atómico, dentro de la tx del
/// alta: sin duplicados bajo concurrencia y sin huecos (un rollback deshace
/// también el incremento).
model ShopSequence {
  id         String   @id @default(uuid(7)) @db.Uuid
  shop_id    String   @db.Uuid
  name       String
  value      Int
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)

  shop Shop @relation(fields: [shop_id], references: [id])

  @@unique([shop_id, name])
  @@map("shop_sequences")
}

/// Estados de la OT. Día 5 usa draft → in_progress → completed y cancelled;
/// awaiting_approval/approved llegan con la DVI (Día 6) e invoiced/paid con el
/// cobro (Día 7).
enum WorkOrderStatus {
  draft
  awaiting_approval
  approved
  in_progress
  completed
  invoiced
  paid
  cancelled
}

/// Orden de trabajo de un taller. FKs compuestas: cliente y vehículo del MISMO
/// taller (lo garantiza la DB). Que el vehículo sea de ese cliente se valida en
/// el servicio al crear (sin FK: si el vehículo cambia de dueño, las OT viejas
/// conservan al dueño de ese momento). Totales en centavos, recalculados en la
/// misma tx que cada cambio de ítems (Día 5.2).
model WorkOrder {
  id                    String          @id @default(uuid(7)) @db.Uuid
  shop_id               String          @db.Uuid
  number                Int
  customer_id           String          @db.Uuid
  vehicle_id            String          @db.Uuid
  status                WorkOrderStatus @default(draft)
  complaint             String
  notes                 String?
  mileage_in            Int?
  /// Miembro del taller asignado (shop_members.id). Sin FK: si se le quita del
  /// taller, la OT conserva el dato histórico y la vista lo ignora.
  assigned_member_id    String?         @db.Uuid
  promised_at           DateTime?       @db.Timestamptz(6)
  currency              String          @default("DOP")
  subtotal_cents        BigInt          @default(0)
  tax_cents             BigInt          @default(0)
  total_cents           BigInt          @default(0)
  /// Momentos de cada transición (historial y métricas del taller).
  started_at            DateTime?       @db.Timestamptz(6)
  completed_at          DateTime?       @db.Timestamptz(6)
  cancelled_at          DateTime?       @db.Timestamptz(6)
  cancellation_reason   String?
  created_by_account_id String          @db.Uuid
  created_at            DateTime        @default(now()) @db.Timestamptz(6)
  updated_at            DateTime        @updatedAt @db.Timestamptz(6)

  shop       Shop            @relation(fields: [shop_id], references: [id])
  customer   Customer        @relation(fields: [customer_id, shop_id], references: [id, shop_id])
  vehicle    Vehicle         @relation(fields: [vehicle_id, shop_id], references: [id, shop_id])
  items      WorkOrderItem[]
  inspection Inspection?
  approvals  WorkOrderApproval[]

  /// Destino de la FK compuesta de work_order_items.
  @@unique([id, shop_id])
  @@unique([shop_id, number])
  @@index([shop_id, status])
  @@index([shop_id, customer_id])
  @@index([shop_id, vehicle_id])
  @@map("work_orders")
}

enum WorkOrderItemType {
  labor
  part
}

/// Línea de una OT: mano de obra o pieza. La aritmética del dinero la
/// garantiza la DB (CHECKs de la migración): subtotal = redondeo(cantidad ×
/// precio), ITBIS = redondeo(subtotal × tasa), total = subtotal + ITBIS.
/// Cantidad en milésimas (1.5 h = 1500): nada de floats.
model WorkOrderItem {
  id                        String            @id @default(uuid(7)) @db.Uuid
  shop_id                   String            @db.Uuid
  work_order_id             String            @db.Uuid
  type                      WorkOrderItemType
  description               String
  part_number               String?
  quantity_milli            Int
  unit_price_cents          BigInt
  /// Tasa de ITBIS en basis points (1800 = 18%; 0 = exento).
  tax_rate_bps              Int               @default(1800)
  /// approved = el taller la cobra; proposed = espera al cliente; declined = el
  /// cliente la rechazó (no suma a los totales ni se cobra).
  approval_status           ItemApprovalStatus @default(approved)
  decided_at                DateTime?         @db.Timestamptz(6)
  subtotal_cents            BigInt
  tax_cents                 BigInt
  total_cents               BigInt
  /// Reservado para el Día 12: compra de la pieza en el marketplace.
  marketplace_order_item_id String?           @db.Uuid
  created_at                DateTime          @default(now()) @db.Timestamptz(6)
  updated_at                DateTime          @updatedAt @db.Timestamptz(6)

  work_order WorkOrder @relation(fields: [work_order_id, shop_id], references: [id, shop_id], onDelete: Cascade)

  @@index([work_order_id])
  @@map("work_order_items")
}

// --- DVI: inspección digital del vehículo (Día 6) ---

/// Severidad de un hallazgo: verde (ok), amarillo (atención), rojo (urgente).
enum FindingSeverity {
  ok
  attention
  urgent
}

enum PhotoStatus {
  pending
  uploaded
}

/// Inspección digital de una OT (una por OT). FKs compuestas por taller en toda
/// la cadena OT → inspección → hallazgo → foto: nada cruza de taller.
model Inspection {
  id                    String   @id @default(uuid(7)) @db.Uuid
  shop_id               String   @db.Uuid
  work_order_id         String   @db.Uuid
  notes                 String?
  created_by_account_id String   @db.Uuid
  created_at            DateTime @default(now()) @db.Timestamptz(6)
  updated_at            DateTime @updatedAt @db.Timestamptz(6)

  work_order WorkOrder           @relation(fields: [work_order_id, shop_id], references: [id, shop_id], onDelete: Cascade)
  findings   InspectionFinding[]

  /// Una inspección por OT (la FK fija shop_id al taller de la OT, así que
  /// este UNIQUE compuesto equivale a UNIQUE(work_order_id)).
  @@unique([work_order_id, shop_id])
  @@unique([id, shop_id])
  @@map("inspections")
}

/// Hallazgo de la inspección (p. ej. Frenos · "Pastillas al 20%" · urgente).
model InspectionFinding {
  id            String          @id @default(uuid(7)) @db.Uuid
  shop_id       String          @db.Uuid
  inspection_id String          @db.Uuid
  area          String
  title         String
  severity      FindingSeverity
  notes         String?
  created_at    DateTime        @default(now()) @db.Timestamptz(6)
  updated_at    DateTime        @updatedAt @db.Timestamptz(6)

  inspection Inspection        @relation(fields: [inspection_id, shop_id], references: [id, shop_id], onDelete: Cascade)
  photos     InspectionPhoto[]

  @@unique([id, shop_id])
  @@index([inspection_id])
  @@map("inspection_findings")
}

/// Foto de un hallazgo. El archivo vive en R2 (`storage_key`, con prefijo del
/// taller); aquí solo metadatos. `pending` hasta que el cliente confirma y la
/// API verifica en R2 que existe con el tamaño/tipo declarados.
model InspectionPhoto {
  id           String      @id @default(uuid(7)) @db.Uuid
  shop_id      String      @db.Uuid
  finding_id   String      @db.Uuid
  storage_key  String      @unique
  content_type String
  size_bytes   Int
  status       PhotoStatus @default(pending)
  uploaded_at  DateTime?   @db.Timestamptz(6)
  created_at   DateTime    @default(now()) @db.Timestamptz(6)
  updated_at   DateTime    @updatedAt @db.Timestamptz(6)

  finding InspectionFinding @relation(fields: [finding_id, shop_id], references: [id, shop_id], onDelete: Cascade)

  @@index([finding_id])
  @@map("inspection_photos")
}

// --- Aprobación del cliente (Día 6) ---

enum ItemApprovalStatus {
  approved
  proposed
  declined
}

enum ApprovalRequestStatus {
  pending
  completed
  revoked
}

/// Solicitud de aprobación enviada al cliente. El enlace lleva un token que es
/// una FIRMA HMAC del id (con un secreto del servidor): el token no se guarda
/// en ningún lado, ni en esta tabla ni en el outbox. Vencimiento y revocación
/// se controlan aquí.
model WorkOrderApproval {
  id                    String                @id @default(uuid(7)) @db.Uuid
  shop_id               String                @db.Uuid
  work_order_id         String                @db.Uuid
  status                ApprovalRequestStatus @default(pending)
  expires_at            DateTime              @db.Timestamptz(6)
  decided_at            DateTime?             @db.Timestamptz(6)
  created_by_account_id String                @db.Uuid
  created_at            DateTime              @default(now()) @db.Timestamptz(6)
  updated_at            DateTime              @updatedAt @db.Timestamptz(6)

  work_order WorkOrder @relation(fields: [work_order_id, shop_id], references: [id, shop_id], onDelete: Cascade)

  @@index([work_order_id])
  @@map("work_order_approvals")
}
